{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expire",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/retry-tsa",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "app/api/**/*": {
      "maxDuration": 60
    }
  }
}
