# ─────────────────────────────────────────────────────────────────────────────
# DocuFirma — environment variables
# Copy to `.env.local` for local development. NEVER commit real values.
# In Vercel, set them under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (used for links in emails, OG metadata, Stripe redirects)
NEXT_PUBLIC_APP_URL=https://docufirma.es

# Supabase (Project Settings → API). The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, only for running migrations / `pnpm test:db`
SUPABASE_DB_URL=

# Stripe (Developers → API keys / Webhooks). Run `pnpm stripe:setup` to create products & prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email). Domain mail.docufirma.es must be verified (see README).
RESEND_API_KEY=
EMAIL_FROM="DocuFirma <no-reply@mail.docufirma.es>"

# Mensatek RFC 3161 Time Stamping Authority (HTTP Basic credentials from the Mensatek panel).
# tsaMENSATEK = 1 credit per stamp · tsaFNMT = 2 credits per stamp (FNMT TSA)
MENSATEK_TSA_ENDPOINT=https://api.mensatek.com/tsaMENSATEK
MENSATEK_TSA_USER=
MENSATEK_TSA_PASSWORD=

# AES-256-GCM key for biometric evidence at rest: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EVIDENCE_ENCRYPTION_KEY=
# Previous keys kept for decryption after a rotation: comma-separated base64 keys (key ids are derived).
EVIDENCE_ENCRYPTION_KEYS_OLD=

# Shared secret for the scheduled jobs → /api/cron/* (sent as `Authorization: Bearer <CRON_SECRET>`).
# Supabase pg_cron sends it: store the same value in Supabase Vault as `cron_secret` (see README).
CRON_SECRET=

# Rate limiting (optional). Without Upstash, a Postgres-backed limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# DOCX → PDF conversion (optional). Base URL of a Gotenberg instance. Empty = only PDF & images accepted.
DOCX_CONVERTER_URL=

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Free signatures granted on sign-up (0 disables the trial)
TRIAL_CREDITS=3
# Retention of biometric evidence, in years (GDPR — see docs/LEGAL.md)
BIOMETRIC_RETENTION_YEARS=5

# Test environments only: disables application rate limits (never set in production)
RATE_LIMIT_DISABLED=
# Show the "Continue with Google" button (enable the Google provider in Supabase Auth first)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Timestamp provider override. "test" uses the local throwaway TSA in tests/fixtures/tsa
# (development / e2e only — tokens have no legal value). Leave empty in production.
TSA_PROVIDER=
# Optional PEM bundle of the TSA chain (Mensatek / FNMT) to enforce chain validation of tokens.
TSA_TRUSTED_CERTS_PEM=
# Also embed a PAdES document timestamp (/DocTimeStamp) in each signed PDF so Adobe Reader shows it.
# Costs one extra TSA stamp per document (the detached .tsr over the final hash is always issued).
PADES_DOC_TIMESTAMP=false
